{
  "version": "2.0.0",
  "name": "@qqnluaq/smk",
  "title": "Simple Map Kit",
  "description": "A simple way to add a map your application.",
  "author": "Ben Jubb <benjubb@gmail.com>",
  "license": "APSL-2.0",
  "homepage": "https://qqnluaq.github.io/smk/",
  "repository": "github:qqnluaq/smk",
  "main": "dist/smk.umd.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "concurrently --kill-others \"npm:build:watch\" \"npm:serve\"",
    "build": "vite build && vite build --config vite.config.standalone.js",
    "build:lite": "vite build",
    "build:standalone": "vite build --config vite.config.standalone.js",
    "build:watch": "vite build --watch",
    "release": "npm run build",
    "serve": "live-server . --open=debug --wait=100 --watch=dist/smk.umd.js,debug,test",
    "vite:dev": "vite",
    "gallery": "vite --open /debug/gallery/",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project browser",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:harness": "npm run build:lite && node build/run-harness.js",
    "ref:v1": "node build/fetch-ref.js",
    "coverage": "vitest run --project unit --coverage",
    "coverage:harness": "npm run build:lite && node build/run-harness.js --coverage && node build/coverage-report.js",
    "coverage:all": "npm run coverage && npm run coverage:harness"
  },
  "devDependencies": {
    "@terraformer/arcgis": "2.1.2",
    "@turf/turf": "5.1.6",
    "@types/esri-leaflet": "3.0.4",
    "@types/jquery": "4.0.0",
    "@types/leaflet": "1.9.21",
    "@types/proj4": "2.5.6",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "5.3.0",
    "esri-leaflet": "3.0.19",
    "esri-leaflet-vector": "4.3.1",
    "jquery": "^3.7.1",
    "jsdom": "29.0.2",
    "leaflet": "1.7.1",
    "live-server": "1.2.2",
    "maplibre-gl": "5.24.0",
    "material-design-icons-iconfont": "6.7.0",
    "monocart-coverage-reports": "^2.13.0",
    "playwright": "^1.62.1",
    "proj4": "2.4.4",
    "qunit": "2.25.0",
    "terser": "^5.46.2",
    "typescript": "^6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5",
    "vue": "^2.7.16"
  }
}
